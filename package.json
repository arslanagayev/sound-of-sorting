{
  "name": "sound-of-sorting",
  "version": "1.0.0",
  "private": true,
  "description": "Watch and hear sorting algorithms: bars, tones and a four-way race between bubble, insertion, merge, quick and heap sort.",
  "keywords": [
    "algorithms",
    "sorting",
    "visualization",
    "web-audio",
    "canvas",
    "typescript",
    "vite"
  ],
  "author": {
    "name": "Arslan Agayev",
    "url": "https://github.com/arslanagayev"
  },
  "license": "MIT",
  "homepage": "https://arslanagayev.github.io/sound-of-sorting/",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.2.6",
    "@fontsource/space-mono": "^5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arslanagayev/sound-of-sorting.git"
  }
}
